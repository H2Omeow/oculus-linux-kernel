# Missing standard-mode prerequisites in the Quest 3S 5.10 configuration.
# Standard-mode prerequisites used by the Droidspaces reference configuration.
# Existing namespace/IPC/NTSYNC/cgroup/network/overlayfs support is checked
# by complete_droidspaces_config.py rather than redundantly overridden here.
CONFIG_DEVTMPFS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
