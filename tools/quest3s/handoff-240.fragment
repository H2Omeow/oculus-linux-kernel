# Quest 3S kexec target: exact 5.10.240 vendor tree + VA48.
CONFIG_ARM64_VA_BITS_48=y
# CONFIG_ARM64_VA_BITS_39 is not set
CONFIG_ARM64_VA_BITS=48
CONFIG_PGTABLE_LEVELS=4

CONFIG_LOCALVERSION="-va48-H2O"
# CONFIG_LOCALVERSION_AUTO is not set

# The target is intentionally a different build from the stock kernel.  Allow
# the stock 5.10.240 vendor modules to load for the first Android bring-up;
# the code-level bypass lives in kernel/module.c.
CONFIG_MODULE_FORCE_LOAD=y
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_ALL is not set
CONFIG_CFI_PERMISSIVE=y
# CONFIG_TRIM_UNUSED_KSYMS is not set

# Keep the device configuration for everything else.
