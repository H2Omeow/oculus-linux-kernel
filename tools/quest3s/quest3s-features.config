# Resolved Quest 3S feature and local build settings.
# Merge after vendor/oculus_anorak_defconfig, then run olddefconfig.
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_BLK_CGROUP=y
CONFIG_BRIDGE=y
CONFIG_CFI_CLANG=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_DEVTMPFS=y
CONFIG_INET=y
CONFIG_INOTIFY_USER=y
CONFIG_IPC_NS=y
CONFIG_IPV6=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_NAT=y
CONFIG_KSU=y
CONFIG_KSU_TRACEPOINT_HOOK=y
CONFIG_LOCALVERSION="-quest3s-va48"
CONFIG_LTO_CLANG_THIN=y
CONFIG_MEMCG=y
CONFIG_NAMESPACES=y
CONFIG_NET=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NET_NS=y
CONFIG_NF_NAT=y
CONFIG_NTSYNC=y
CONFIG_OVERLAY_FS=y
CONFIG_PID_NS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_PROC_FS=y
CONFIG_QCOM_KGSL=m
CONFIG_QCOM_KGSL_GPU_VA48=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SYSFS=y
CONFIG_SYSVIPC=y
CONFIG_TMPFS=y
CONFIG_TRACEPOINTS=y
CONFIG_TUN=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_VETH=y
# CONFIG_ARM64_16K_PAGES is not set
# CONFIG_ARM64_64K_PAGES is not set
# CONFIG_ARM64_VA_BITS_39 is not set
# CONFIG_CFI_PERMISSIVE is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_LTO_CLANG_FULL is not set
# CONFIG_META_SAMPLE_PGO is not set
