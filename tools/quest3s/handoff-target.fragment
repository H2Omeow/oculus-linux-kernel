# Quest 3S VA48 target: configuration delta applied on top of the *device's*
# own configuration (device/stock-5.10.240-g9cb2f620a9a8.config, read from the
# running kernel's /proc/config.gz).
#
# Rationale: the published vendor/oculus_anorak_defconfig is not the device's
# configuration.  The device build enables 11 drivers that defconfig leaves
# out (SND_SOC_MAX98388, SENSORLOCK, VIRTUAL_SENSOR, OCULUS_CHARGING_DOCK,
# AK09973, USB_PDFU, LEDS_CLASS_FLASH/LEDS_QTI_FLASH/LEDS_TRIGGER_DEFAULT_ON,
# IIO_KFIFO_BUF, IIO_TRIGGERED_BUFFER) and sets META_DTS_DIR="panther".
# Deriving the target from the device configuration keeps every driver the
# device actually loads and limits the delta to the requested features.

# --- user-space VA48 (4 KiB, four level) -----------------------------------
CONFIG_ARM64_VA_BITS_48=y
# CONFIG_ARM64_VA_BITS_39 is not set

# --- requested features ----------------------------------------------------
CONFIG_NTSYNC=y
CONFIG_QCOM_KGSL=m
CONFIG_QCOM_KGSL_GPU_VA48=y
CONFIG_KSU=y
CONFIG_KSU_TRACEPOINT_HOOK=y
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y
# CONFIG_KSU_MANUAL_HOOK is not set
# CONFIG_KSU_DEBUG is not set

# --- Droidspaces standard-mode kernel prerequisites ------------------------
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FHANDLE=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_DEVTMPFS=y
# CONFIG_DEVTMPFS_MOUNT is not set
CONFIG_OVERLAY_FS=y
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NF_LOG_IPV4=y
CONFIG_NF_LOG_IPV6=y
CONFIG_SYSCTL=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_NETFILTER=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_LOG=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_CT=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# --- handoff bring-up ------------------------------------------------------
# Deadman restart + boot banner: the only way to recover a log from a kernel
# that was handed off without a console (see drivers/misc/quest_handoff.c).
CONFIG_QUEST_HANDOFF=y

# --- identity --------------------------------------------------------------
CONFIG_LOCALVERSION="-va48-H2O"
# CONFIG_LOCALVERSION_AUTO is not set

# --- build shape -----------------------------------------------------------
# ThinLTO keeps the link inside a CI runner's memory; the device build used
# full LTO.  Neither is an ABI promise: the target's modules are rebuilt from
# this same tree.
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_CLANG_FULL is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_META_SAMPLE_PGO is not set

CONFIG_CFI_PERMISSIVE=y
CONFIG_MODULE_FORCE_LOAD=y
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_ALL is not set

# --- RPMh warm-handoff safety ---------------------------------------------
# The stock config leaves the whole RPMh stack modular, so Android's vendor
# ramdisk loads the old modules after the handoff.  A warm handoff does not
# reset the RSC, and those modules have no stale-TCS cleanup.  Build the
# providers into the target so the patched probe in rpmh-rsc.c runs before
# any vendor module can submit the first RPMh request.
#
# REGULATOR_RPMH is the correct symbol for this device tree: ravelin uses
# qcom,rpmh-vrm-regulator/qcom,rpmh-arc-regulator (generic RPMh VRM), not
# qcom,pm8150-rpmh-regulators (REGULATOR_QCOM_RPMH).  CLUSTER_PD is a PSCI
# power domain, so QCOM_RPMHPD is not used here either.
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_REGULATOR_RPMH=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM_RPMH_POSSIBLE=y
CONFIG_INTERCONNECT_QCOM_BCM_VOTER=y
CONFIG_INTERCONNECT_QCOM_ANORAK=y
